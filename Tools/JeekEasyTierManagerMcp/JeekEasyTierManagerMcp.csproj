<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JeekEasyTierManagerMcp</AssemblyName>
    <RootNamespace>JeekEasyTierManagerMcp</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Ships beside the app: the adapter derives the instance id from its own folder.
         Published as a single file so NetBeauty never sees its runtimeconfig.json (a patched
         adapter would hold libloader.dll open and break the app's next build). -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>..\..\bin</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single source of truth for pipe names, shared with the app. -->
    <Compile Include="..\..\JeekEasyTierManager\Module\McpPipeNames.cs" Link="McpPipeNames.cs" />
  </ItemGroup>

</Project>
